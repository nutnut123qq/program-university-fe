{
  "info": {
    "sylid": 14200,
    "subjectCode": "SAP312",
    "syllabusName": "Hệ thống ERP: khái niệm và thực hành với SAP_ERP System: Concepts and practice with SAP",
    "syllabusEnglish": "ERP System: Concepts and practice with SAP",
    "credits": "3",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (150h) = 45h (60 sessions) contact hours + 1h final exam + 104h self-study",
    "prerequisite": "None",
    "description": "The course demonstrates concepts, principles, techniques, and applications of ERP systems in general and SAP in particular. The course recalls the components and the structure of an enterprise and introduces the design of SAP that is compatible with this structure. The course also introduces 4 SAP modules including SD (Sales Distribution), MM (Material Management), WM (Ware House Management) and FI (Finance Accouting), . Theory, case study, practical sessions and workshop with SAP",
    "studentTasks": "- Students must attend at least 80% of contact slots in order to be accepted to the final examination.\n\n- Student is responsible to do all exercises, assignments and labs given by instructor in class or at home and submit on time\n\n- Use laptop in class only for learning purpose\n\n- Promptly access to http://flm.fpt.edu.vn for up-to-date course information",
    "tools": "- Internet\n\n- SAP Hana 4",
