    {
      "id": 4122,
      "sylid": 13036,
      "loSeq": "1",
      "cloName": "CLO1",
      "loDetails": "Describe cultural dimensions based on cultural frameworks and apply them to global business settings."
    },
    {
      "id": 4123,
      "sylid": 13036,
      "loSeq": "2",
      "cloName": "CLO10",
      "loDetails": "Identify different negotiation scenarios, then formulate and apply the instruments of negotiation strategy and tactics."
    },
    {
      "id": 4124,
      "sylid": 13036,
      "loSeq": "3",
      "cloName": "CLO2",
      "loDetails": "Develop cultural intelligence to interact and manage people from different cultures."
    },
    {
      "id": 4125,
      "sylid": 13036,
      "loSeq": "4",
      "cloName": "CLO3",
      "loDetails": "Developing capability to competently apply course concepts in cross- cultural situations that require responses at the individual, managerial and organisational levels."
    },
    {
      "id": 4126,
      "sylid": 13036,
      "loSeq": "5",
      "cloName": "CLO4",
      "loDetails": "Identify the major dimensions of culture relevant to work settings and discuss their effect on behavior in an international environment. Describe negotiation styles in different cultures; adjust negotiation tactics to cultural differences."
    },
    {
      "id": 4127,
      "sylid": 13036,
      "loSeq": "6",
      "cloName": "CLO5",
      "loDetails": "Explain the motivation, leadership and HR selection across cultures."
    },
    {
      "id": 4128,
      "sylid": 13036,
      "loSeq": "7",
      "cloName": "CLO6",
      "loDetails": "Develop cultural sensitivity needed to succeed in any kind of cross-cultural interactions."
    },
    {
      "id": 4129,
      "sylid": 13036,
      "loSeq": "8",
      "cloName": "CLO7",
      "loDetails": "Differentiate the different types of negotiation approaches (integrative, distributive negotiations)."
    },
    {
      "id": 4130,
      "sylid": 13036,
      "loSeq": "9",
      "cloName": "CLO8",
      "loDetails": "Describe the strategies and actions taken on different stages of negotiations; appreciate and explain the importance of pre-; during and post-negotiation phases."
    },
    {
      "id": 4131,
      "sylid": 13036,
      "loSeq": "10",
      "cloName": "CLO9",
      "loDetails": "List the roles and functions in negotiation teams; demonstrate the skills of organizing and managing negotiation teams."
    }
