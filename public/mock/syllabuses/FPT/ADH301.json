  "clos": [
    {
      "id": 4680,
      "sylid": 13376,
      "loSeq": "1",
      "cloName": "CLO1",
      "loDetails": "Explain the core principles of interaction and user experience (UX) design in mobile and wearable contexts, including smartphones, smartwatches, and other responsive platforms."
    },
    {
      "id": 4681,
      "sylid": 13376,
      "loSeq": "2",
      "cloName": "CLO2",
      "loDetails": "Identify and analyze platform-specific UI/UX guidelines (e.g., Android, iOS, and others) and adapt design approaches accordingly."
    },
    {
      "id": 4682,
      "sylid": 13376,
      "loSeq": "3",
      "cloName": "CLO3",
      "loDetails": "Conduct UX and visual research to gather user needs, identify design patterns, and explore visual languages that inform concept development and design directions."
    },
    {
      "id": 4683,
      "sylid": 13376,
      "loSeq": "4",
      "cloName": "CLO4",
      "loDetails": "Apply the obtained knowledge to implement a research and designing process for a real product."
    },
    {
      "id": 4684,
      "sylid": 13376,
      "loSeq": "5",
      "cloName": "CLO5",
      "loDetails": "Investigate and analyze technologies relevant to the product context (e.g., APIs, sensors, databases), and propose practical solutions that define how data is processed and how user actions flow through the system."
    },
    {
      "id": 4685,
      "sylid": 13376,
      "loSeq": "6",
      "cloName": "CLO6",
      "loDetails": "Design and prototype digital products by expressing distinctive visual concepts through both low- and high-fidelity prototypes using up-to-date design tools and systems."
    },
    {
      "id": 4686,
      "sylid": 13376,
      "loSeq": "7",
      "cloName": "CLO7",
      "loDetails": "Evaluate user experience through usability testing and user feedback, and refine solutions through improvement cycles, focusing on consistency, performance, and emotional impact."
    }
  ],
