{
  "info": {
    "sylid": 10032,
    "subjectCode": "AIP391",
    "syllabusName": "AI programming project_Dự án lập trình TTNT",
    "syllabusEnglish": "AI programming project",
    "credits": "3",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (150h) = 45h contact hours + 105h self-study",
    "prerequisite": "AIG201c, PRP201c",
    "description": "The initial course for students to become familiar with AI problems. Through sample tutorials, students can understand the practical application of AI, how to perform step-by-step, the knowledge to equip the field of AI (computer vision, natural language processing, data science, robotics..).\n\nThe Project provides students, working in groups, with a significant project experience in which they can integrate much of the material they have learned in their program, including matters relating to introduction, design, human factors, professionalism, and project management.\n\nStudents will be guided to develop a software system, employing knowledge gained from courses throughout the program.",
    "studentTasks": "# Choose appropriate project and form group.\n\n# Divide and schedule work among members.\n\n# Produce document and product according to project requirement and member work share.\n\n# Defend work infront of examination board, showing both project results and individual responsibility.",
    "tools": "# Choose appropriate project and form group.\n\n# Divide and schedule work among members.\n\n# Produce document and product according to project requirement and member work share.\n\n# Defend work infront of examination board, showing both project results and individual responsibility.",
    "scoringScale": "10",
    "decisionNo": "808/QĐ-ĐHFPT dated 08/03/2023",
    "isApproved": 1,
    "note": "Completion Criteria (in addition to grade criteria):\n\n* Students can prove that they create the product themselves\n\n* No fatal defect in software product (the students can't demonstrate)",
    "minAvgToPass": "5",
