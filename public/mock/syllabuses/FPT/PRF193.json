  "clos": [
    {
      "id": 4256,
      "sylid": 13190,
      "loSeq": "1",
      "cloName": "CLO1",
      "loDetails": "Understand and apply fundamental concepts in C/C++ programming, including C/C++ keywords, variable types, Lvalues and Rvalues, operators, strings, arrays, and pointers."
    },
    {
      "id": 4257,
      "sylid": 13190,
      "loSeq": "2",
      "cloName": "CLO2",
      "loDetails": "Implement decision-making constructs (if-else, switch), loops (for, while, do-while), and modify program flow using control flow keywords (break, continue, goto)."
    },
    {
      "id": 4258,
      "sylid": 13190,
      "loSeq": "3",
      "cloName": "CLO3",
      "loDetails": "Define, declare, and implement functions in C/C++, using modular programming techniques such as recursion, function pointers, and parameter passing."
    },
    {
      "id": 4259,
      "sylid": 13190,
      "loSeq": "4",
      "cloName": "CLO4",
      "loDetails": "Understand and apply object-oriented programming (OOP) principles like encapsulation, inheritance, and polymorphism. Use pointers, references, dynamic memory allocation, and smart pointers in C++ for efficient memory management. Avoid memory leaks and dangling pointers while working with classes, constructors, destructors, templates, and exceptions."
    },
    {
      "id": 4260,
      "sylid": 13190,
      "loSeq": "5",
      "cloName": "CLO5",
      "loDetails": "Open, read, write, and close files using C/C++ file handling functions and streams. Distinguish between binary and text file formats and perform random access operations."
    },
    {
      "id": 4261,
      "sylid": 13190,
      "loSeq": "6",
      "cloName": "CLO6",
      "loDetails": "Use AI Tools and Computational Thinking (CT) tools to identify, analyze, model, and demonstrate problem-solving"
    }
  ],
