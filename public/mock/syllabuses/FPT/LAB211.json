    "sylid": 10021,
    "subjectCode": "LAB211",
    "syllabusName": "OOP with Java Lab_Thực hành OOP với Java",
    "syllabusEnglish": "OOP with Java Lab",
    "credits": "3",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (150h) = 45h contact hours + 105h self-study",
    "prerequisite": "PRO192",
    "description": "This course focuses on basic problems related to Java programming skills. Students are required to implement all assignments by him/her self in lab rooms.\n\nEach assignment must be completed continuosly in the defined time.",
    "studentTasks": "- Students must attend at least 80% of contact slots in order to be accepted to the final results.\n\n- Students are responsible to conform to Lab Room Regulations\n\n- Use desktop computers only in lab room for learning purposes\n\n- Promptly access to the FU LMS at https://flm.fpt.edu.vn/ for up-to-date course information",
    "tools": "NetBean 8.0.2\n\nCheckStyle plugin for netbeans\n\nJAVA DOC\n\nJDK8\n\nTomcat Apache 8\n\nMicrosoft Excel 2007 or above\n\nMicrosoft Word 2007 or above\n\nMicrosoft Powerpoint 2007 or above\n\nMicrosoft Windows XP or above",
