      "loSeq": "5",
      "cloName": "CLO5",
      "loDetails": "Evaluate crypto monetary instrument by comparing design mechanisms and assessing key risks."
    },
    {
      "id": 5981,
      "sylid": 14090,
      "loSeq": "6",
      "cloName": "CLO6",
      "loDetails": "Analyze DeFi market mechanisms such as DEX/AMM and liquidity pools; calculate/interpret pricing outcomes and assess liquidity & risk trade-offs"
    },
    {
      "id": 5982,
      "sylid": 14090,
      "loSeq": "7",
      "cloName": "CLO7",
      "loDetails": "Assess DAO-based governance models and token incentives; propose governance/risk-control measures for DeFi protocols"
    },
    {
