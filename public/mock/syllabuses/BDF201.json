{
  "info": {
    "sylid": 14090,
    "subjectCode": "BDF201",
    "syllabusName": "Blockchain and decentralized finance _Công nghệ Blockchain và Tài chính phi tập trung",
    "syllabusEnglish": "Blockchain and Decentralized Finance",
    "credits": "3",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (150h) = 45h (60 sessions) contact hours + 1h final exam + 104h self-study",
    "prerequisite": "none",
    "description": "This course introduces blockchain technology and its applications in cryptocurrencies and decentralized finance (DeFi). It covers cryptographic primitives (hash functions, digital signatures), blockchain data structures (blocks, Merkle trees), network architecture (nodes, mempool), consensus mechanisms and security (PoW/PoS, forks, double spending, 51% attack), and the evolution from Bitcoin to smart-contract platforms. The DeFi part focuses on financial primitives and protocols such as stablecoins, decentralized exchanges and automated market makers (AMMs), liquidity pools, tokenization and NFTs, governance via DAOs, and key issues in risk management, security, and regulation. Students will practice using wallets, block explorers, and smart-contract sandboxes; analyze real-world DeFi cases and on-chain data; and propose a DeFi/FinTech solution with clear assumptions, risks, and compliance considerations.",
    "studentTasks": "Students must attend at least 80% of contact sessions to be eligible for the final assessment. - Complete required readings and pre-class preparation; actively participate in discussions, case analyses, and in-class exercises. Complete and submit all quizzes/assignments/labs/projects on time; contribute fairly and professionally in group work. Follow academic integrity rules (no plagiarism, proper citation, no unauthorized collaboration); use AI tools responsibly and transparently when allowed by the instructor. - Use laptops/tablets in class strictly for learning activities. For hands-on blockchain labs: use testnets/sandbox accounts unless explicitly instructed; do NOT share private keys/seed phrases; follow security best practices.",
    "tools": null,
    "scoringScale": "10",
    "decisionNo": "377/QĐ-ĐHFPT dated 04/09/2026",
    "isApproved": 1,
    "note": "Notes: - Blockchain & DeFi evolve rapidly; readings, examples, and tool versions may be updated during the semester. - The course is for educational purposes only and is NOT investment advice. - Students are not required to use real funds; labs can be completed fully on test networks.",
