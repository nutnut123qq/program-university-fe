{
  "info": {
    "sylid": 14070,
    "subjectCode": "IAP491",
    "syllabusName": "IA Capstone Project_Đồ án tốt nghiệp an toàn thông tin",
    "syllabusEnglish": "IA Capstone Project",
    "credits": "10",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (500h) = 33.75h contact hours (1NewSlot/Week * 15 Weeks) + 1.5h capstone project defense + 464.75h self-study",
    "prerequisite": "- Must pass 80% of total credits (PHE_COM* and OJT excluded)\n- Must pass the OJT stage and following subjects:\no IAP301 Policy Development in Information Assurance;\no NWC302/303 (or NWC204);\no One of four specialized courses in specified field (IAM302, FRS401(c), HOD401, DBS401).",
    "description": "The Capptone Project provides students, working in groups (each group consists of 4-5 students), with a significant project experience in which they can integrate much of the material they have learned in their program, including matters relating to requirements, design, human factors, professionalism, and project management.\n\nStudents will be guided to Develop an IA solution, employing knowledge gained from courses throughout the program. It includes development of risk assessement, analysis and management, implementation, and quality assurance. Students may follow any suitable process model, must pay attention to quality issues, and must manage the project themselves, following all appropriate project management techniques. Success of the project is determined in large part by whether students have adequately solved their customer’s problem.",
    "studentTasks": "# Choose project at project market and form group.\n\n# Divide and schedule work among members\n\n# Attend all scheduled meeting with supervisor.\n\n# Produce document and product according to project requirement and member work share.\n\n# Defence work infront of examination board, showing both project results and individual responsibility\n\n# Students are required to attend at least 80% of scheduled meetings with their supervisor(s) to be eligible for the thesis or capstone defense.",
    "tools": "Appropriate tools for design and implementation.",
    "scoringScale": "10",
    "decisionNo": "377/QĐ-ĐHFPT dated 04/09/2026",
    "isApproved": 1,
    "note": "1) On-going Assessment\n\n- Project documents: 50%\n\n2) Final Project Presentation: 50%\n\n3) Final Result: 100%\n\nCompletion Criteria:\n\n1) Every on-going assessment component >0\n\n2) On-going assessment: 4 reports, after 6 weeks >=5\n\n3) On-going assessment >=5\n\n4) Project Defense >=4\n\n5) Final Result >=5",
    "minAvgToPass": "5",
    "isActive": 1,
