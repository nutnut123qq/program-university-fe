  "info": {
    "sylid": 14147,
    "subjectCode": "MSA201",
    "syllabusName": "Mô hình và mô phỏng_Modeling and Simulation for Automotive Systems",
    "syllabusEnglish": "Modeling and Simulation for Automotive Systems",
    "credits": "3",
    "degreeLevel": "Bachelor",
    "timeAllocation": "Study hour (150h) = 45h contact hours + 1h final exam + 104h self-study",
    "prerequisite": "AEE301",
    "description": "The module equips you with knowledge on how to simulate and model elements in the automotive industry. In this course, students will learn about building digital models to simulate and test various elements of the automotive development process.\n\nThis course provides fundamental concepts and practical techniques of modeling and simulation in the context of digital automotive systems. Students will learn to develop and analyze digital models to simulate vehicle subsystems, embedded software behavior, and automotive development processes, supporting design validation, system integration, and performance optimization in software-defined vehicles.",
    "studentTasks": "- Students must attend at least 80% of contact slots in order to be accepted to the final examination.\n\n- Student is responsible to do all exercises, assignments and labs given by instructor in class or at home and submit on time\n\n- Use laptop in class only for learning purpose\n\n- Promptly access to the FU FLM at https://flm.fpt.edu.vn/ for up-to-date course information",
    "tools": "- Intenet\n\n- Textbook\n\n- AI and Simulation Tools",
