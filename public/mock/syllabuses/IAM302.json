      "id": 2501,
      "sylid": 11196,
      "loSeq": "1",
      "cloName": "CLO1",
      "loDetails": "Develop a good understanding of Malware Analysis: today’s greatly increasing malware threats, malware activity mechanism and behavior, malware classification, building an environment to do static and dynamic malware analysis, methods and tools to detect, analyze, reverse-engineer, and eradicate malware."
    },
    {
      "id": 2502,
      "sylid": 11196,
      "loSeq": "2",
      "cloName": "CLO2",
      "loDetails": "Identify the different types of Malware Analysis methods: static (ASCII, binary, logical signature detection), dynamic (network traffic analysis, memory forensics, dynamic reverse engineering) and hybrid."
    },
    {
      "id": 2503,
      "sylid": 11196,
      "loSeq": "3",
      "cloName": "CLO3",
      "loDetails": "Gain a broad exposure to real world applications of Malware Analysis: take control of the incident, incident response, analyze the threat, examine interactions with the environment, mitigate the risks of malware attempting to escape from the lab,"
    },
    {
      "id": 2504,
      "sylid": 11196,
      "loSeq": "4",
      "cloName": "CLO4",
      "loDetails": "Set up a relatively inexpensive lab for Malware Analysis activities."
    },
    {
      "id": 2505,
      "sylid": 11196,
      "loSeq": "5",
      "cloName": "CLO5",
      "loDetails": "Utilize a standard methodology for detecting, analyzing, reverse engineering, and eradicating malware."
    },
    {
      "id": 2506,
      "sylid": 11196,
      "loSeq": "6",
      "cloName": "CLO6",
      "loDetails": "Use a Malware Analysis-based approach in order to resolve real world problems."
    },
