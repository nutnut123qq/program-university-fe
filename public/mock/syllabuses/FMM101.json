{
  "info": {
    "sylid": 945,
    "subjectCode": "FMM101",
    "syllabusName": "FUNDALMENTALS OF MULTIMEDIA",
    "syllabusEnglish": null,
    "credits": "3",
    "degreeLevel": "Bachelor in Business Administration",
    "timeAllocation": "30 sessions; 1 session= 90 minutes",
    "prerequisite": null,
    "description": "This course introduces multimedia elements, theories, and hardware/software\n\ncomponents of multimedia including image, graphics, sound, and video components. In related with the multimedia elements, students learn the fundamental of multimedia processing, multimedia design, including principles of graphic design;introduction to authoring; on-screen layout; and introduction to authoring tools. This class will also include a brief introduction to authoring\n\nsoftware. By teaching not only fundamental technologies but also emerging technologies, the course provides the most essential skills in handling multimedia tools and designing multimedia content in a evelopment\n\nenvironment.",
    "studentTasks": "- Attend more than 80% of contact hours in order to be accepted to the final examination\n\n- Actively participate in class activities\n\n- Fulfill tasks given by instructor after class\n\n- Use their own laptop in class only for learning purpose\n\n- Read the textbook in advance\n\n- Access the course website (www.cms.fpt.edu.vn) for up-to-date information and material of the course, for online supports from teachers and other students and for practicing and assessment.",
    "tools": null,
